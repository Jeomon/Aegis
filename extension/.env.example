# Aegis credentials — SERVER SIDE ONLY.
#
# The browser extension deliberately does NOT read this file. Vite would inline any value
# here into dist/, and an unpacked extension is readable by anyone who installs it, so a
# key committed to the bundle is a published key.
#
# In the extension, credentials live in chrome.storage.local instead. Set one from the
# side panel:
#
#     key nvidia nvapi-xxxxxxxx
#     config
#
# Copy this file to .env and fill in only the providers you actually use. The variable
# names match `credentialName` in src/providers.ts.

# https://build.nvidia.com — free tier for Developer Program members.
# Only use models the catalogue marks "Downloadable": the problem statement requires
# open weights, and endpoint-only models fail that test.
NVIDIA_API_KEY=

# https://openrouter.ai — widest catalogue, mixes open and closed models. Check before use.
OPENROUTER_API_KEY=

# https://api.together.xyz
TOGETHER_API_KEY=

# https://console.groq.com
GROQ_API_KEY=

# Ollama and vLLM run locally and need no credential:
#   ollama pull qwen2.5vl:7b
#   ollama serve                      # http://127.0.0.1:11434/v1
